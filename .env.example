# =============================================================================
# Deriverse Trading Analytics – Environment (no API key required)
# =============================================================================
# Copy to .env and adjust if needed. Public Solana devnet RPC works out of the box.
# For production/mainnet, replace RPC with a dedicated provider (e.g. Helius, QuickNode).
# =============================================================================

# Solana RPC (used by wallet connection and, when integrated, @deriverse/kit)
NEXT_PUBLIC_RPC_HTTP=https://api.devnet.solana.com
NEXT_PUBLIC_RPC_WS=wss://api.devnet.solana.com

# Deriverse protocol (from official kit-example – required when using @deriverse/kit)
NEXT_PUBLIC_PROGRAM_ID=Drvrseg8AQLP8B96DBGmHRjFGviFNYTkHueY9g3k27Gu
NEXT_PUBLIC_DERIVERSE_VERSION=12

# Optional: token mints for specific markets (e.g. SOL/USDC on devnet)
# NEXT_PUBLIC_TOKEN_MINT_A=9pan9bMn5HatX4EJdBwg9VgCa7Uz5HL8N1m5D3NdXejP
# NEXT_PUBLIC_TOKEN_MINT_B=A2Pz6rVyXuadFkKnhMXd1w9xgSrZd8m8sEGpuGuyFhaj
